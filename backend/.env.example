# Copy to backend/.env for local development. Never commit backend/.env.
FLASK_DEBUG=1
SECRET_KEY=replace-with-a-local-development-secret
DATABASE_URL=sqlite:///fraudlens-development.sqlite3
# PostgreSQL is intentionally not connected in this foundation phase.
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/fraudlens

# Active FastAPI frozen deployment. Blank uses the repository-local default.
FRAUD_DEPLOYMENT_DIR=
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173,http://localhost:8080,http://localhost:8081
